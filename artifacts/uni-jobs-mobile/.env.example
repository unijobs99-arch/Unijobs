# UniJobs Mobile App - Environment Configuration
# Copy this file to .env.local and update with your values

# API Server Configuration
# ========================
# For Local Development (Expo Go on physical device):
# 1. Find your machine's IP address:
#    - Windows: ipconfig (look for IPv4 Address)
#    - Mac/Linux: ifconfig or ip addr
# 2. Make sure your backend is running: PORT=5000 pnpm run dev
# 3. Set EXPO_PUBLIC_DOMAIN to: YOUR_MACHINE_IP:5000
#
# Example: EXPO_PUBLIC_DOMAIN=192.168.1.100:5000
#
# For Replit Development:
# EXPO_PUBLIC_DOMAIN is auto-set via REPLIT_DEV_DOMAIN in the dev script
#
# For Production:
# EXPO_PUBLIC_DOMAIN=api.yourdomain.com (or your production API domain)

EXPO_PUBLIC_DOMAIN=192.168.1.100:5000

# For local web testing (localhost):
# EXPO_PUBLIC_DOMAIN=localhost:5000
